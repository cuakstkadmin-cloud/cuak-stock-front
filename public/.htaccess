# La app es una SPA: React Router resuelve las rutas dentro de index.html.
# Sin esto, entrar directo a /inicio o recargar en /productos da el 404 del servidor.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si el archivo o la carpeta existen (JS, CSS, imágenes), se sirven tal cual
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta la resuelve la app: ella decide si va al login o a la principal
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html sin caché: así cada despliegue nuevo se ve de inmediato
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Los archivos de /assets llevan un hash en el nombre: pueden guardarse por un año
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
